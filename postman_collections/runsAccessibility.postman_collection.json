			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Response Status Code Should Be 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"const responseJson = pm.response.json();",
							"const result = responseJson.result;",
							"const pageInfo = result.pageInfo;",
							"// get total pages",
							"let totalPages = pageInfo.total;",
							"let currentPage = pageInfo.number;",
							"",
							"// set load ids list",
							"let loadsIds ;",
							"if(currentPage === 1){",
							" ",
							"   loadsIds = []",
							"",
							"}",
							"else{",
							"   // Parse the containerIds collection variable",
							"   loadsIds = JSON.parse(pm.collectionVariables.get(\"loadsIds\")); ",
							"}",
							"data = result.data;",
							"data.forEach(function (load) {",
							"",
							"    loadsIds.push(load.id);",
							"});",
							"",
							"pm.collectionVariables.set(\"loadsIds\", JSON.stringify(loadsIds));",
							"loadsIds = JSON.parse(pm.collectionVariables.get(\"loadsIds\")); ",
							"",
							"if(currentPage < totalPages){",
							"    let nextPage = currentPage + 1;",
							"    pm.collectionVariables.set(\"pageNumber\", nextPage);",
							"    pm.execution.setNextRequest(pm.info.requestId);",
							"",
							"}",
							"else{",
							"    pm.collectionVariables.set(\"pageNumber\", 1);",
							"}",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
