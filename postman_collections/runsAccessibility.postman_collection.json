							"",
							"if(index < loadIds.length){",
							"   let id = loadIds[index];",
							"   pm.collectionVariables.set(\"loadId\", id);",
							"   pm.execution.setNextRequest(pm.info.requestId);",
							"   index = index + 1;",
							"   pm.collectionVariables.set(\"idIndex\",  index);",
